# Mixpanel
VITE_MIXPANEL_ENABLED=false
VITE_MIXPANEL_PROJECT_TOKEN=

# Overrides debug mode in user settings
VITE_DEBUG_MODE=false


# Secret Network endpoints (override the public defaults in src/utils/config.ts).
# Set these in your local .env (gitignored) to the real private/paid endpoints.
# Do NOT commit private endpoint URLs here.
# LCD = secretjs query endpoint (gRPC-web/REST). RPC = Tendermint RPC (IBC broadcasts only).
VITE_SECRET_LCD=
VITE_SECRET_RPC=

# Transak
TRANSAK_API_KEY=